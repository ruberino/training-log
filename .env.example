# Environment for local development. Copy to .env and fill in the required values.
# See docs/architecture.md section 9 for the full description of each variable.

# development | production. production enables Secure cookies and serves the built client.
NODE_ENV=development

# Listen port. The Dockerfile sets this to 8080.
PORT=3000

# Listen address.
HOST=0.0.0.0

# SQLite file path. The Dockerfile sets this to /data/training-log.db.
DATABASE_PATH=./data/training-log.db

# Required. Shared household password, at least 8 characters.
APP_PASSWORD=

# Required. HMAC key for the auth cookie, at least 32 characters. Rotating it logs everyone out.
SESSION_SECRET=

# pino log level.
LOG_LEVEL=info

# Time zone used for log timestamps. The server never computes "today" from this.
TZ=Europe/Oslo

# Litestream replication target. Read by start.sh and litestream.yml only.
# Without LITESTREAM_BUCKET the app runs without replication.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
